 <Styles>
   <Style ss:ID="Default" ss:Name="Normal"> // 기본 설정
     <Alignment ss:Vertical="Bottom" ss:Horizontal="Automatic"/>
     <Borders/>
     <Font/>
     <Interior/>
     <NumberFormat/>
     <Protection/>
   </Style>

   <Style ss:ID="outLine"> // 셀 테두리 지정(상하좌우 각각 지정됨)
     <Borders>
       <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1"/>
       <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1"/>
       <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1"/>
       <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1"/>
       <Border ss:Position="DiagonalLeft" ss:LineStyle="None" ss:Weight="1"/>
       <Border ss:Position="DiagonalRight" ss:LineStyle="None" ss:Weight="1"/>
     </Borders>
   </Style>

   <Style ss:ID="darkTitle"> // 제목 셀(어둡게)
     <Alignment ss:Horizontal="Center"/> //정렬
     <Font ss:Size="11" ss:Bold="1" ss:Color="#000000"/> //글꼴 크기, 굵게, 색깔
     <Interior ss:Color="#EEEEEE" ss:Pattern="Solid"/> //배경색
     <Borders>
       <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1"/>
       <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1"/>
       <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1"/>
       <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1"/>
       <Border ss:Position="DiagonalLeft" ss:LineStyle="None" ss:Weight="1"/>
       <Border ss:Position="DiagonalRight" ss:LineStyle="None" ss:Weight="1"/>
     </Borders>
   </Style>

   <Style ss:ID="yellow"> //노란 배경 셀
     <Alignment ss:Horizontal="Right"/>
     <Font ss:Size="11"/>
     <Interior ss:Color="#fde9d9" ss:Pattern="Solid"/>
     <Borders>
       <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1"/>
       <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1"/>
       <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1"/>
       <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1"/>
       <Border ss:Position="DiagonalLeft" ss:LineStyle="None" ss:Weight="1"/>
       <Border ss:Position="DiagonalRight" ss:LineStyle="None" ss:Weight="1"/>
     </Borders>
   </Style>

   <Style ss:ID="s9"> //일반 셀
     <Alignment ss:Horizontal="Right"/>
     <Font ss:Size="11"/>
     <Borders>
       <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1"/>
       <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1"/>
       <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1"/>
       <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1"/>
       <Border ss:Position="DiagonalLeft" ss:LineStyle="None" ss:Weight="1"/>
       <Border ss:Position="DiagonalRight" ss:LineStyle="None" ss:Weight="1"/>
     </Borders>
   </Style>
   <Style ss:ID="s10"> //일반 셀
     <Alignment ss:Horizontal="Right"/>
     <Font ss:Size="11"/>
     <Borders>
       <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1"/>
       <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1"/>
       <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1"/>
       <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1"/>
       <Border ss:Position="DiagonalLeft" ss:LineStyle="None" ss:Weight="1"/>
       <Border ss:Position="DiagonalRight" ss:LineStyle="None" ss:Weight="1"/>
     </Borders>
     <NumberFormat ss:Format="yyyy-mm-dd hh:mm:ss"/>
   </Style>

 </Styles>

